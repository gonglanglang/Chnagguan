# 复制本文件为 application-local.yml 后填入你本机的 MySQL 密码（已加入 .gitignore，不会提交到仓库）
spring:
  datasource:
    username: root
    password: your_mysql_password

guoguanla:
  oss:
    enabled: true
    endpoint: oss-cn-shenzhen.aliyuncs.com
    # ECS 同地域部署时可填内网节点（如 oss-cn-shenzhen-internal.aliyuncs.com），免公网出站流量且支持流式转发 APK
    internal-endpoint: ""
    # 若在 OSS 绑定已备案自定义域名（CNAME），填入后 APK 与媒体签名直链将自动切换为自定义域名
    custom-domain: ""
    bucket: chuangguang
    access-key-id: your_oss_access_key_id
    access-key-secret: your_oss_access_key_secret
